{
    "manifest_version": 3,
    "name": "自动开启哔哩哔哩字幕",
    "version": "1.1",
    "description": "自动开启哔哩哔哩字幕 插件",

    "background":{
        "service_worker":"background.js"
    },

    "icons": {
        "128": "img/logo.png",
        "48": "img/logo.png",
        "16": "img/logo.png"
    },
    "action": {
        
        "default_icon": {
            "16": "img/logo.png",
            "48": "img/logo.png",
            "128": "img/logo.png"
        }
    },
    
    "content_scripts": [
        {
          "matches": ["https://www.bilibili.com/video/**"],
          "js": ["content-script.js"]
        }
      ],
      

    "permissions":["scripting","activeTab"]


}